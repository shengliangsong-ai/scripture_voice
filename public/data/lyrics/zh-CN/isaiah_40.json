{
  "bookSlug": "isaiah",
  "chapter": 40,
  "lang": "zh-CN",
  "title": "等候耶和华必从新得力",
  "tempoNote": "沉稳圣诗 · 70 BPM · A大调",
  "verse1": [
    "少年也会疲乏困倦，",
    "花草随着季节凋残，",
    "惟有你的话语永远立定，",
    "在黑影掠过时依然坚固。"
  ],
  "chorus": [
    "凡等候耶和华的人，",
    "必从新得着刚强力量；",
    "如大鹰展翅乘风上腾，",
    "行走在正路永不疲乏。"
  ],
  "verse2": [
    "数算星宿的创造主啊，",
    "你不打盹也不曾困倦，",
    "将勇气浇灌在软弱里面，",
    "点亮心中不熄的盼望。"
  ],
  "bridge": [
    "行走不疲乏，奔跑不困倦，",
    "每一步都有你恩典托住。"
  ]
}