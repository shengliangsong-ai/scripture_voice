{
  "bookSlug": "john",
  "chapter": 3,
  "lang": "zh-CN",
  "title": "夜深庭院的灯火",
  "tempoNote": "沉思圣咏 · 66 BPM · G大调",
  "verse1": [
    "橄榄树影静静垂落，",
    "城门沉睡在夜色中，",
    "寻道者带着心中的疑问，",
    "走向微光闪烁的庭院。"
  ],
  "chorus": [
    "神爱世人赐下独生子，",
    "不是定罪乃是要拯救；",
    "如晚风轻轻吹醒林梢，",
    "你为我开启重生之门。"
  ],
  "verse2": [
    "没有脚步能攀登天际，",
    "没有书卷能更新灵魂，",
    "惟有圣灵在深处吹气，",
    "领我回到你的怀抱中。"
  ],
  "bridge": [
    "走出幽暗来到光里，",
    "恩典比恐惧更加深广；",
    "永恒生命就在今夜开始，",
    "因为救主的话语就在身旁。"
  ]
}