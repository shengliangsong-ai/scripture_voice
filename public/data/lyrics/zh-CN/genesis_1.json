{
  "bookSlug": "genesis",
  "chapter": 1,
  "lang": "zh-CN",
  "title": "在深渊之上发出光来",
  "tempoNote": "圣诗慢板 · 68 BPM · C大调",
  "verse1": [
    "群山尚未立定根基，",
    "海潮尚未学会歌唱，",
    "你的灵运行在黑暗中，",
    "温柔气息覆庇水面上。"
  ],
  "chorus": [
    "向幽暗发出光来，",
    "向深海宣告平安；",
    "那铺张晨曦的声音，",
    "正使我心灵得安息。"
  ],
  "verse2": [
    "你分开黑夜与清晨，",
    "你使荒芜大地开花，",
    "将你形像吹入尘土，",
    "使我们同行在你家。"
  ],
  "bridge": [
    "有晚上也有早晨，",
    "每个应许永不改变；",
    "你手所造都甚美好，",
    "万物齐声称颂你名。"
  ]
}