{
  "bookSlug": "1corinthians",
  "chapter": 13,
  "lang": "zh-CN",
  "title": "其中最大的是爱",
  "tempoNote": "温暖木吉他 · 76 BPM · D大调",
  "verse1": [
    "我若能说万人的方言，",
    "又明白诸般的奥秘，",
    "若没有爱在心里运行，",
    "不过是响钹空洞声音。"
  ],
  "chorus": [
    "爱是恒久忍耐又有恩慈，",
    "不计算人过犯的账簿；",
    "如今仿佛对镜模糊观看，",
    "爱却永不止息直到永远。"
  ],
  "verse2": [
    "凡事包容也凡事盼望，",
    "不求自己的益处与冠冕；",
    "不喜欢不义只喜悦真理，",
    "在静默中显出真实力量。"
  ],
  "bridge": [
    "信是锚定，望要升起，",
    "直到与你面对面相见；",
    "常存的有信有望有爱，",
    "其中最大的永远是爱。"
  ]
}