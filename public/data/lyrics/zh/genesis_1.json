{
  "bookSlug": "genesis",
  "chapter": 1,
  "lang": "zh",
  "title": "在深淵之上發出光來",
  "tempoNote": "聖詩慢板 · 68 BPM · C大調",
  "verse1": [
    "群山尚未立定根基，",
    "海潮尚未學會歌唱，",
    "祢的靈運行在黑暗中，",
    "溫柔氣息覆庇水面上。"
  ],
  "chorus": [
    "向幽暗發出光來，",
    "向深海宣告平安；",
    "那鋪張晨曦的聲音，",
    "正使我心靈得安息。"
  ],
  "verse2": [
    "祢分開黑夜與清晨，",
    "祢使荒蕪大地開花，",
    "將祢形像吹入塵土，",
    "使我們同行在祢家。"
  ],
  "bridge": [
    "有晚上也有早晨，",
    "每個應許永不改變；",
    "祢手所造都甚美好，",
    "萬物齊聲稱頌祢名。"
  ]
}