{
  "bookSlug": "1corinthians",
  "chapter": 13,
  "lang": "zh",
  "title": "其中最大的是愛",
  "tempoNote": "溫暖木吉他 · 76 BPM · D大調",
  "verse1": [
    "我若能說萬人的方言，",
    "又明白諸般的奧秘，",
    "若沒有愛在心裡運行，",
    "不過是響鈸空洞聲音。"
  ],
  "chorus": [
    "愛是恆久忍耐又有恩慈，",
    "不計算人過犯的帳簿；",
    "如今彷彿對鏡模糊觀看，",
    "愛卻永不止息直到永遠。"
  ],
  "verse2": [
    "凡事包容也凡事盼望，",
    "不求自己的益處與冠冕；",
    "不喜歡不義只喜悅真理，",
    "在靜默中顯出真實力量。"
  ],
  "bridge": [
    "信是錨定，望要升起，",
    "直到與祢面對面相見；",
    "常存的有信有望有愛，",
    "其中最大的永遠是愛。"
  ]
}