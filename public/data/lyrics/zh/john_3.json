{
  "bookSlug": "john",
  "chapter": 3,
  "lang": "zh",
  "title": "夜深庭院的燈火",
  "tempoNote": "沉思聖詠 · 66 BPM · G大調",
  "verse1": [
    "橄欖樹影靜靜垂落，",
    "城門沉睡在夜色中，",
    "尋道者帶著心中的疑問，",
    "走向微光閃爍的庭院。"
  ],
  "chorus": [
    "神愛世人賜下獨生子，",
    "不是定罪乃是要拯救；",
    "如晚風輕輕吹醒林梢，",
    "祢為我開啟重生之門。"
  ],
  "verse2": [
    "沒有腳步能攀登天際，",
    "沒有書卷能更新靈魂，",
    "惟有聖靈在深處吹氣，",
    "領我回到祢的懷抱中。"
  ],
  "bridge": [
    "走出幽暗來到光裡，",
    "恩典比恐懼更加深廣；",
    "永恆生命就在今夜開始，",
    "因為救主的話語就在身旁。"
  ]
}