{
  "bookSlug": "isaiah",
  "chapter": 40,
  "lang": "zh",
  "title": "等候耶和華必從新得力",
  "tempoNote": "沉穩聖詩 · 70 BPM · A大調",
  "verse1": [
    "少年也會疲乏困倦，",
    "花草隨著季節凋殘，",
    "惟有祢的話語永遠立定，",
    "在黑影掠過時依然堅固。"
  ],
  "chorus": [
    "凡等候耶和華的人，",
    "必從新得著剛強力量；",
    "如大鷹展翅乘風上騰，",
    "行走在正路永不疲乏。"
  ],
  "verse2": [
    "數算星宿的創造主啊，",
    "祢不打盹也不曾困倦，",
    "將勇氣澆灌在軟弱裡面，",
    "點亮心中不熄的盼望。"
  ],
  "bridge": [
    "行走不疲乏，奔跑不困倦，",
    "每一步都有祢恩典托住。"
  ]
}