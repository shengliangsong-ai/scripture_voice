{
  "bookSlug": "psalm",
  "chapter": 23,
  "lang": "zh",
  "title": "可安歇的水邊",
  "tempoNote": "牧歌默想 · 72 BPM · G大調",
  "verse1": [
    "青草地上金光照耀，",
    "急流學會在岸邊安靜，",
    "祢喚我疲倦的心靈深呼吸，",
    "把重擔輕輕交託給祢。"
  ],
  "chorus": [
    "雖行過死蔭的幽谷，",
    "我並不孤單走這路；",
    "祢的杖與竿安慰我心，",
    "大牧者時刻緊緊守護。"
  ],
  "verse2": [
    "在憂慮前祢擺設筵席，",
    "恩膏滿溢使福杯湧流；",
    "祢的信實伴隨我腳蹤，",
    "越過高山也越過山丘。"
  ],
  "bridge": [
    "一生一世恩惠相隨，",
    "慈愛將我緊緊環繞；",
    "我要住在耶和華殿中，",
    "安息在祢永恆懷抱。"
  ]
}