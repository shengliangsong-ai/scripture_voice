{
  "bookSlug": "proverbs",
  "bookName": "箴言",
  "chapter": 3,
  "lang": "zh-CN",
  "translation": "和合本 (CUV Simplified)",
  "verses": [
    {
      "verse": 1,
      "text": "我儿，不要忘记我的法则；你心要谨守我的诫命；"
    },
    {
      "verse": 3,
      "text": "不可使慈爱、诚实离开你，要系在你颈项上，刻在你心版上。"
    },
    {
      "verse": 5,
      "text": "你要专心仰赖耶和华，不可倚靠自己的聪明，"
    },
    {
      "verse": 6,
      "text": "在你一切所行的事上都要认定他，他必指引你的路。"
    }
  ],
  "isPreseeded": true
}