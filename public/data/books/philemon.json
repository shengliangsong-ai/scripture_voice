,"要":2,"要行":1,"行的":1,"的必":1,"必过":1,"过于":1,"我所":1,"所说":1,"说的":1,"的此":1,"此外":1,"外":1,"外你":1,"你还":1,"还要":1,"要给":1,"我预":1,"预":1,"预备":1,"备":1,"备住":1,"住":1,"住处":1,"处因":1,"因为":1,"我盼":1,"盼":1,"盼望":1,"望借":1,"借":1,"借着":1,"着你":1,"的祷":1,"告必":1,"必蒙":1,"蒙":1,"蒙恩":1,"恩到":1,"们那":1,"去为":1,"稣与":1,"我同":2,"同坐":1,"坐":1,"坐监":1,"监":1,"监的":1,"的以":1,"以巴":1,"巴":1,"巴弗":1,"弗":1,"弗问":1,"问你":2,"你安":2,"安与":1,"工的":1,"的马":1,"马":2,"马可":1,"可亚":1,"亚里":1,"里达":1,"达":1,"达古":1,"古":1,"古底":1,"底":1,"马路":1,"路":1,"路加":1,"加":1,"加也":1,"也都":1,"都问":1,"安愿":1,"愿我":1,"们主":1,"督的":1,"的恩":1,"恩常":1,"常在":1,"心里":1,"里阿":1},"verseMap":[{"verse":1,"text":"Paul, a prisoner of Christ Jesus, and Timothy our brother, to Philemon, our beloved fellow worker,"},{"verse":2,"text":"to the beloved Apphia, to Archippus our fellow soldier, and to the assembly in your house:"},{"verse":3,"text":"Grace to you and peace from God our Father and the Lord Jesus Christ."},{"verse":4,"text":"I thank my God always, making mention of you in my prayers,"},{"verse":5,"text":"hearing of your love and of the faith which you have toward the Lord Jesus and toward all the saints,"},{"verse":6,"text":"that the fellowship of your faith may become effective in the knowledge of every good thing which is in us in Christ Jesus."},{"verse":7,"text":"For we have much joy and comfort in your love, because the hearts of the saints have been refreshed through you, brother."},{"verse":8,"text":"Therefore though I have all boldness in Christ to command you that which is appropriate,"},{"verse":9,"text":"yet for love’s sake I rather appeal to you, being such a one as Paul, the aged, but also a prisoner of Jesus Christ."},{"verse":10,"text":"I appeal to you for my child Onesimus, whom I have become the father of in my chains,"},{"verse":11,"text":"who once was useless to you, but now is useful to you and to me."},{"verse":12,"text":"I am sending him back. Therefore receive him, that is, my own heart,"},{"verse":13,"text":"whom I desired to keep with me, that on your behalf he might serve me in my chains for the Good News."},{"verse":14,"text":"But I was willing to do nothing without your consent, that your goodness would not be as of necessity, but of free will."},{"verse":15,"text":"For perhaps he was therefore separated from you for a while that you would have him forever,"},{"verse":16,"text":"no longer as a slave, but more than a slave, a beloved brother—especially to me, but how much rather to you, both in the flesh and in the Lord."},{"verse":17,"text":"If then you count me a partner, receive him as you would receive me."},{"verse":18,"text":"But if he has wronged you at all or owes you anything, put that to my account."},{"verse":19,"text":"I, Paul, write this with my own hand: I will repay it (not to mention to you that you owe to me even your own self besides)."},{"verse":20,"text":"Yes, brother, let me have joy from you in the Lord. Refresh my heart in the Lord."},{"verse":21,"text":"Having confidence in your obedience, I write to you, knowing that you will do even beyond what I say."},{"verse":22,"text":"Also, prepare a guest room for me, for I hope that through your prayers I will be restored to you."},{"verse":23,"text":"Epaphras, my fellow prisoner in Christ Jesus, greets you,"},{"verse":24,"text":"as do Mark, Aristarchus, Demas, and Luke, my fellow workers."},{"verse":25,"text":"The grace of our Lord Jesus Christ be with your spirit. Amen."}],"hasArtwork":true,"artworkUrl":"/data/images/books/philemon.svg","availableLangs":["en","zh-CN"]}]