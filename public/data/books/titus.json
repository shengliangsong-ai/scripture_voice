topped: men who overthrow whole houses, teaching things which they ought not, for dishonest gain’s sake."},{"verse":12,"text":"One of them, a prophet of their own, said, “Cretans are always liars, evil beasts, and idle gluttons.”"},{"verse":13,"text":"This testimony is true. For this cause, reprove them sharply, that they may be sound in the faith,"},{"verse":14,"text":"not paying attention to Jewish fables and commandments of men who turn away from the truth."},{"verse":15,"text":"To the pure, all things are pure, but to those who are defiled and unbelieving, nothing is pure; but both their mind and their conscience are defiled."},{"verse":16,"text":"They profess that they know God, but by their deeds they deny him, being abominable, disobedient, and unfit for any good work."}],"hasArtwork":true,"artworkUrl":"/data/images/books/titus.svg","availableLangs":["en","zh-CN"]},{"id":"titus_2","bookSlug":"titus","chapter":2,"reference":"Titus 2","title":"Titus 2 — Public Domain Study","topics":["titus","titus","nt","scripture","提多書","提多书","純正的道理","纯正的道理"],"snippet":{"en":"But say the things which fit sound doctrine,","zh-CN":"但你所讲的总要合乎那纯正的道理。"},"tokens":{"15":2,"56":1,"titus":10,"public":2,"domain":2,"study":1,"nt":1,"scripture":1,"提多書":1,"提多书":2,"純正的道理":1,"纯正的道理":1,"but":3,"say":5,"the":14,"things":7,"which":4,"fit":2,"sound":3,"doctrine":3,"that":10,"older":2,"men":3,"should":1,"be":9,"temperate":1,"sensible":1,"sober":3,"minded":3,"in":12,"faith":1,"love":3,"and":14,"perseverance":1,"women":1,"likewise":2,"reverent":1,"behavior":1,"not":4,"slanderers":1,"nor":1,"enslaved":1,"to":15,"much":1,"wine":1,"teachers":1,"of":11,"is":1,"good":4,"they":2,"may":4,"train":1,"young":1,"wives":1,"their":4,"husbands":2,"children":1,"chaste":1,"workers":1,"at":1,"home":1,"kind":1,"being":1,"subjection":2,"own":3,"god":5,"word":1,"blasphemed":1,"exhort":4,"younger":1,"all":8,"show":2,"yourself":1,"an":1,"example":1,"works":2,"your":2,"teaching":1,"integrity":1,"seriousness":1,"incorrup