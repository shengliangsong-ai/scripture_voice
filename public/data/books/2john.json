너":1,"희에":3,"게나":1,"나아":1,"아가":1,"가거":1,"거든":1,"든그":1,"를집":1,"집":1,"에들":1,"들이":1,"이지":1,"지도":1,"도말":2,"고인":1,"인사":2,"사도":1,"라그":1,"그에":1,"게인":1,"사하":1,"는그":1,"그악":1,"악":1,"한일":1,"에참":1,"참예":1,"예하":1,"자임":1,"임이":1,"라내":1,"가너":1,"게쓸":1,"쓸":1,"쓸것":1,"이많":1,"많으":1,"으나":1,"나종":1,"종":1,"종이":1,"이와":1,"와먹":1,"먹":1,"먹으":1,"로쓰":1,"쓰기":1,"기를":1,"를원":1,"치":1,"치아":1,"하고":1,"오히":1,"히려":1,"려":3,"려너":1,"게가":1,"서면":1,"면":1,"면대":1,"대하":1,"여말":1,"말하":1,"려하":1,"희기":1,"기쁨":1,"쁨":1,"쁨을":1,"을충":1,"충":1,"충만":1,"만":1,"만케":1,"케":1,"케하":1,"려함":1,"라택":1,"은네":1,"네자":1,"자매":1,"매":1,"매의":1,"녀가":1,"가네":1,"게문":1,"문":1,"문안":1,"안하":1,"하느":1},"verseMap":[{"verse":1,"text":"The elder, to the chosen lady and her children, whom I love in truth, and not I only, but also all those who know the truth,"},{"verse":2,"text":"for the truth’s sake, which remains in us, and it will be with us forever:"},{"verse":3,"text":"Grace, mercy, and peace will be with us, from God the Father and from the Lord Jesus Christ, the Son of the Father, in truth and love."},{"verse":4,"text":"I rejoice greatly that I have found some of your children walking in truth, even as we have been commanded by the Father."},{"verse":5,"text":"Now I beg you, dear lady, not as though I wrote to you a new commandment, but that which we had from the beginning, that we love one another."},{"verse":6,"text":"This is love, that we should walk according to his commandments. This is the commandment, even as you heard from the beginning, that you should walk in it."},{"verse":7,"text":"For many deceivers have gone out into the world, those who don’t confess that Jesus Christ came in the flesh. This is the deceiver and the Antichrist."},{"verse":8,"text":"Watch yourselves, that we don’t lose the things which we have accomplished, but that we receive a full reward."},{"verse":9,"text":"Whoever transgresses and doesn’t remain in the teaching of Christ doesn’t have God. He who remains in the teaching has both the Father and the Son."},{"verse":10,"text":"If anyone comes to you and doesn’t bring this teaching, don’t receive him into your house, and don’t welcome him,"},{"verse":11,"text":"for he who welcomes him participates in his evil deeds."},{"verse":12,"text":"Having many things to write to you, I don’t want to do so with paper and ink, but I hope to come to you and to speak face to face, that our joy may be made full."},{"verse":13,"text":"The children of your chosen sister greet you. Amen."}],"hasArtwork":false,"availableLangs":[]}]