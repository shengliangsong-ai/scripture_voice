l way and from the violence that is in his hands."},{"verse":9,"text":"Who knows whether God will not turn and relent, and turn away from his fierce anger, so that we might not perish?”"},{"verse":10,"text":"God saw their works, that they turned from their evil way. God relented of the disaster which he said he would do to them, and he didn’t do it."}],"hasArtwork":true,"artworkUrl":"/data/images/books/jonah.svg","availableLangs":["zh-CN"]},{"id":"jonah_4","bookSlug":"jonah","chapter":4,"reference":"Jonah 4","title":"Jonah 4 — Public Domain Study","topics":["jonah","jonah","ot","scripture","約拿書","约拿书","約拿的忿怒和上帝的憐憫","约拿的忿怒和 神的怜悯"],"snippet":{"zh-CN":"这事约拿大大不悦，且甚发怒，"},"tokens":{"11":2,"32":1,"jonah":10,"public":2,"domain":2,"study":1,"ot":1,"scripture":1,"約拿書":1,"约拿书":2,"約拿的忿怒和上帝的憐憫":1,"约拿的忿怒和":1,"神的怜悯":1,"这事约拿大大不悦":1,"且甚发怒":1,"就祷告耶和华说":1,"耶和华啊":2,"我在本国的时候岂不是这样说吗":1,"我知道你是有恩典":1,"有怜悯的":1,"不轻易发怒":1,"有丰盛的慈爱":1,"并且后悔不降所说的灾":1,"所以我急速逃往他施去":1,"现在求你取我的命吧":1,"因为我死了比活着还好":1,"耶和华说":2,"你这样发怒合乎理吗":1,"于是约拿出城":1,"坐在城的东边":1,"在那里为自己搭了一座棚":1,"坐在棚的荫下":1,"要看看那城究竟如何":1,"耶和华":1,"神安排一棵蓖麻":1,"使其发生高过约拿":1,"影儿遮盖他的头":1,"救他脱离苦楚":1,"约拿因这棵蓖麻大大喜乐":1,"次日黎明":1,"神却安排一条虫子咬这蓖麻":1,"以致枯槁":1,"日头出来的时候":1,"神安排炎热的东风":1,"日头曝晒约拿的头":1,"使他发昏":1,"他就为自己求死":1,"我死了比活着还好":1,"神对约拿说":1,"你因这棵蓖麻发怒合乎理吗":1,"他说":2,"我发怒以至于死":1,"都合乎理":1,"这蓖麻不是你栽种的":1,"也不是你培养的":1,"一夜发生":1,"一夜干死":1,"你尚且爱惜":1,"何况这尼尼微大城":1,"其中不能分辨左手右手的有十二万多人":1,"并有许多牲畜":1,"我岂能不爱惜呢":1,"belongs":1,"to":3,"the":5,"book":2,"of":4,"old":2,"testament":2,"spanning":1,"chapters":1,"this":1,"chapter":2,"contains":1,"verses":1,"compiled":1,"locally":1,"from":2,"world":1,"english":1,"bible":1,"web":1,"opening":1,"passage":1,"but":1,"it":1,"displeased":1,"exceedingly":1,"and":4,"he":1,"was":1,"angry":1,"reading":1,"in":2,"sequence":1,"helps":1,"trace":1,"god":1,"covenant":1,"faithfulness":1,"across":1,"broader":1,"narrative":1,"rather":1,"than":2,"isolating":1,"single":1,"lines":1,"out":1,"context":1,"closing":1,"cadence":1,"shouldn":1,"be":1,"concerned":1,"for":1,"nineveh"