":1,"补砖":1,"砖":1,"砖窑":1,"窑":1,"窑在":1,"在那":1,"那里":1,"里":1,"里火":1,"火必":1,"必烧":1,"烧灭":1,"灭":2,"灭你":2,"你刀":1,"刀必":1,"必杀":1,"杀戮":1,"戮":1,"戮你":1,"你吞":1,"吞":1,"吞灭":1,"你如":1,"同蝻":1,"蝻":3,"蝻子":3,"子任":1,"任":1,"任你":1,"你加":1,"加":1,"加增":1,"增":2,"增人":1,"人数":1,"数多":1,"多如":3,"如蝻":1,"子多":1,"如蝗":2,"蝗":2,"蝗虫":2,"虫":2,"虫吧":1,"吧":1,"吧你":1,"你增":1,"增添":1,"添":1,"添商":1,"商":1,"商贾":1,"贾":1,"贾多":1,"多过":1,"过":1,"过天":1,"天":2,"天上":1,"的星":1,"星":1,"星蝻":1,"子吃":1,"吃尽":1,"尽":1,"尽而":1,"而去":1,"去你":1,"的首":1,"首领":1,"领":1,"领多":1,"虫你":1,"的军":1,"军长":1,"长":1,"长仿":1,"仿":1,"仿佛":1,"佛":1,"佛成":1,"成群":1,"群":1,"群的":1,"的蚂":1,"蚂":1,"蚂蚱":1,"蚱":1,"蚱天":1,"天凉":1,"凉的":1,"的时":1,"时":2,"时候":1,"候":1,"候齐":1,"齐":1,"齐落":1,"在篱":1,"篱":1,"篱笆":1,"笆":1,"笆上":1,"上日":1,"日":1,"日头":1,"头":1,"头一":1,"一出":1,"出":1,"出便":1,"便":1,"便都":1,"都飞":1,"飞":1,"飞去":1,"去人":1,"人不":1,"不知":1,"知":1,"知道":1,"道":1,"道落":1,"在何":1,"处亚":1,"亚述":1,"述":1,"述王":1,"王":1,"王啊":1,"啊":1,"啊你":1,"的牧":1,"牧":1,"牧人":1,"人睡":1,"睡":1,"睡觉":1,"觉":1,"觉你":1,"的贵":1,"贵胄":1,"胄":1,"胄安":1,"安歇":1,"歇":1,"歇你":1,"民散":1,"散":1,"散在":1,"在山":1,"山":1,"山间":1,"间无":1,"无人":1,"人招":1,"招":1,"招聚":1,"聚":1,"聚你":1,"的损":1,"损":1,"损伤":1,"伤无":1,"无法":1,"法":1,"法医":1,"医":1,"医治":1,"治":1,"治你":1,"的伤":1,"伤痕":1,"痕":1,"痕极":1,"极":1,"极其":1,"其":1,"其重":1,"重":1,"重大":1,"大凡":1,"凡听":1,"听":1,"听你":1,"你信":1,"信":1,"信息":1,"息的":1,"的必":1,"必都":1,"因此":1,"此":1,"此向":1,"向你":1,"你拍":1,"拍":1,"拍掌":1,"掌":1,"掌你":1,"你所":1,"所行":1,"行的":1,"的恶":1,"恶":1,"恶谁":1,"谁没":1,"没有":1,"有时":1,"时常":1,"常":1,"常遭":1,"遭":1,"遭遇":1,"遇":1,"遇呢":1},"verseMap":[{"verse":1,"text":"Woe to the bloody city! It is all full of lies and robbery—no end to the prey."},{"verse":2,"text":"The noise of the whip, the noise of the rattling of wheels, prancing horses, and bounding chariots,"},{"verse":3,"text":"the horseman charging, and the flashing sword, the glittering spear, and a multitude of slain, and a great heap of corpses, and there is no end of the bodies. They stumble on their bodies"},{"verse":4,"text":"because of the multitude of the prostitution of the alluring prostitute, the mistress of witchcraft, who sells nations through her prostitution, and families through her witchcraft."},{"verse":5,"text":"“Behold, I am against you,” says the LORD of Armies, “and I will lift your skirts over your face. I will show the nations your nakedness, and the kingdoms your shame."},{"verse":6,"text":"I will throw abominable filth on you and make you vile, and will make you a spectacle."},{"verse":7,"text":"It will happen that all those who look at you will flee from you, and say, ‘Nineveh is laid waste! Who will mourn for her?’ Where will I seek comforters for you?”"},{"verse":8,"text":"Are you better than No-Amon, who was situated among the rivers, who had the waters around her, whose rampart was the sea, and her wall was of the sea?"},{"verse":9,"text":"Cush and Egypt were her boundless strength. Put and Libya were her helpers."},{"verse":10,"text":"Yet was she carried away. She went into captivity. Her young children also were dashed in pieces at the head of all the streets, and they cast lots for her honorable men, and all her great men were bound in chains."},{"verse":11,"text":"You also will be drunken. You will be hidden. You also will seek a stronghold because of the enemy."},{"verse":12,"text":"All your fortresses will be like fig trees with the first-ripe figs. If they are shaken, they fall into the mouth of the eater."},{"verse":13,"text":"Behold, your troops among you are women. The gates of your land are set wide open to your enemies. The fire has devoured your bars."},{"verse":14,"text":"Draw water for the siege. Strengthen your fortresses. Go into the clay, and tread the mortar. Make the brick kiln strong."},{"verse":15,"text":"There the fire will devour you. The sword will cut you off. It will devour you like the grasshopper. Multiply like grasshoppers. Multiply like the locust."},{"verse":16,"text":"You have increased your merchants more than the stars of the skies. The grasshopper strips and flees away."},{"verse":17,"text":"Your guards are like the locusts, and your officials like the swarms of locusts, which settle on the walls on a cold day, but when the sun appears, they flee away, and their place is not known where they are."},{"verse":18,"text":"Your shepherds slumber, king of Assyria. Your nobles lie down. Your people are scattered on the mountains, and there is no one to gather them."},{"verse":19,"text":"There is no healing your wound, for your injury is fatal. All who hear the report of you clap their hands over you, for who hasn’t felt your endless cruelty?"}],"hasArtwork":true,"artworkUrl":"/data/images/books/nahum.svg","availableLangs":["zh-CN"]}]