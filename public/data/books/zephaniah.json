门槛":1,"槛":1,"槛都":1,"都必":2,"毁坏":1,"坏":1,"坏香":1,"香":1,"香柏":1,"柏":1,"柏木":1,"木":1,"木已":1,"已":1,"已经":1,"经":2,"经露":1,"露":1,"露出":1,"出这":1,"这是":1,"是素":1,"素":1,"素来":1,"来欢":1,"欢":1,"欢乐":1,"乐":1,"乐安":1,"安":1,"安然":1,"然居":1,"住的":1,"的城":1,"城":1,"城心":1,"心":1,"心里":1,"里说":1,"说惟":1,"惟":1,"惟有":1,"有我":1,"我除":1,"除":1,"除我":1,"我以":1,"以外":1,"外":1,"外再":1,"再":1,"再没":1,"有别":1,"别":1,"别的":1,"的现":1,"现":1,"现在":1,"在何":1,"何":1,"何竟":1,"竟":1,"竟荒":1,"凉成":1,"成":1,"成为":1,"为野":1,"野兽":1,"兽躺":1,"卧之":1,"之处":1,"处凡":1,"凡":1,"凡经":1,"经过":1,"过的":1,"人都":1,"必摇":1,"摇":1,"摇手":1,"手嗤":1,"嗤":1,"嗤笑":1,"笑":1,"笑她":1,"她":1},"verseMap":[{"verse":1,"text":"Gather yourselves together, yes, gather together, you nation that has no shame,"},{"verse":2,"text":"before the appointed time when the day passes as the chaff, before the fierce anger of the LORD comes on you, before the day of the LORD’s anger comes on you."},{"verse":3,"text":"Seek the LORD, all you humble of the land, who have kept his ordinances. Seek righteousness. Seek humility. It may be that you will be hidden in the day of the LORD’s anger."},{"verse":4,"text":"For Gaza will be forsaken, and Ashkelon a desolation. They will drive out Ashdod at noonday, and Ekron will be rooted up."},{"verse":5,"text":"Woe to the inhabitants of the sea coast, the nation of the Cherethites! The LORD’s word is against you, Canaan, the land of the Philistines. I will destroy you until there is no inhabitant."},{"verse":6,"text":"The sea coast will be pastures, with cottages for shepherds and folds for flocks."},{"verse":7,"text":"The coast will be for the remnant of the house of Judah. They will find pasture. In the houses of Ashkelon, they will lie down in the evening, for the LORD, their God, will visit them and restore them."},{"verse":8,"text":"I have heard the reproach of Moab and the insults of the children of Ammon, with which they have reproached my people and magnified themselves against their border."},{"verse":9,"text":"Therefore, as I live, says the LORD of Armies, the God of Israel, surely Moab will be as Sodom, and the children of Ammon as Gomorrah, a possession of nettles and salt pits, and a perpetual desolation. The remnant of my people will plunder them, and the survivors of my nation will inherit them."},{"verse":10,"text":"This they will have for their pride, because they have reproached and magnified themselves against the people of the LORD of Armies."},{"verse":11,"text":"The LORD will be awesome to them, for he will famish all the gods of the land. Men will worship him, everyone from his place, even all the shores of the nations."},{"verse":12,"text":"You Cushites also, you will be killed by my sword."},{"verse":13,"text":"He will stretch out his hand against the north, destroy Assyria, and will make Nineveh a desolation, as dry as the wilderness."},{"verse":14,"text":"Herds will lie down in the middle of her, all kinds of animals. Both the pelican and the porcupine will lodge in its capitals. Their calls will echo through the windows. Desolation will be in the thresholds, for he has laid bare the cedar beams."},{"verse":15,"text":"This is the joyous city that lived carelessly, that said in her heart, “I am, and there is no one besides me.” How she has become a desolation, a place for animals to lie down in! Everyone who passes by her will hiss and shake their fists."}],"hasArtwork":true,"artworkUrl":"/data/images/books/zephaniah.svg","availableLangs":["zh-CN"]},{"id":"zephaniah_3","bookSlug":"zephaniah","chapter":3,"reference":"Zephaniah 3","title":"Zephaniah 3 — Public Domain Study","topics":["zephaniah","zephaniah","ot","scripture","西番雅書","西番雅书","耶路撒冷的罪惡和救贖","耶路撒冷的罪恶和救赎"],"snippet":{"zh-CN":"这悖逆、污秽、欺压的城有祸了！"},"tokens":{"20":2,"36":1,"zephaniah":9,"public":2,"domain":2,"study":1,"ot":1,"scripture":1,"西番雅書":1,"西番雅书":2,"耶路撒冷的罪惡和救贖":1,"耶路撒冷的罪恶和救赎":1,"这悖逆":1,"污秽":2,"欺压的城有祸了":1,"她不听从命令":1,"不领受训诲":1,"不倚靠耶和华":1,"不亲近她的":1,"她中间的首领是咆哮的狮子":1,"她的审判官是晚上的豺狼":1,"一点食物也不留到早晨":1,"她的先知是虚浮诡诈的人":1,"她的祭司亵渎圣所":1,"强解律法":1,"耶和华在她中间是公义的":1,"断不做