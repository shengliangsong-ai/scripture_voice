,"问你":1,"们安":1,"安凡":1,"凡我":1,"我的":2,"的信":1,"信都":1,"都以":1,"以此":1,"此":1,"此为":1,"为记":1,"记我":1,"的笔":1,"笔迹":1,"迹":1,"迹就":1,"就是":1,"是这":1,"样愿":1,"愿我":1,"们主":1,"的恩":1,"恩":1,"恩常":1},"verseMap":[{"verse":1,"text":"Finally, brothers, pray for us, that the word of the Lord may spread rapidly and be glorified, even as also with you,"},{"verse":2,"text":"and that we may be delivered from unreasonable and evil men; for not all have faith."},{"verse":3,"text":"But the Lord is faithful, who will establish you and guard you from the evil one."},{"verse":4,"text":"We have confidence in the Lord concerning you, that you both do and will do the things we command."},{"verse":5,"text":"May the Lord direct your hearts into God’s love and into the perseverance of Christ."},{"verse":6,"text":"Now we command you, brothers, in the name of our Lord Jesus Christ, that you withdraw yourselves from every brother who walks in rebellion and not after the tradition which they received from us."},{"verse":7,"text":"For you know how you ought to imitate us. For we didn’t behave ourselves rebelliously among you,"},{"verse":8,"text":"neither did we eat bread from anyone’s hand without paying for it, but in labor and travail worked night and day, that we might not burden any of you."},{"verse":9,"text":"This was not because we don’t have the right, but to make ourselves an example to you, that you should imitate us."},{"verse":10,"text":"For even when we were with you, we commanded you this: “If anyone is not willing to work, don’t let him eat.”"},{"verse":11,"text":"For we hear of some who walk among you in rebellion, who don’t work at all, but are busybodies."},{"verse":12,"text":"Now those who are that way, we command and exhort in the Lord Jesus Christ, that they work with quietness and eat their own bread."},{"verse":13,"text":"But you, brothers, don’t be weary in doing what is right."},{"verse":14,"text":"If any man doesn’t obey our word in this letter, note that man and have no company with him, to the end that he may be ashamed."},{"verse":15,"text":"Don’t count him as an enemy, but admonish him as a brother."},{"verse":16,"text":"Now may the Lord of peace himself give you peace at all times in all ways. The Lord be with you all."},{"verse":17,"text":"I, Paul, write this greeting with my own hand, which is the sign in every letter. This is how I write."},{"verse":18,"text":"The grace of our Lord Jesus Christ be with you all. Amen."}],"hasArtwork":true,"artworkUrl":"/data/images/books/2thessalonians.svg","availableLangs":["zh-CN"]}]