":1,"같":1,"같이":1,"이우":2,"리도":1,"도빛":1,"면우":1,"가서":1,"로사":1,"고그":1,"수의":1,"의피":1,"피":1,"를모":1,"모":2,"든":2,"든죄":1,"죄":5,"죄에":1,"에서":2,"서깨":1,"깨":2,"깨끗":2,"끗":2,"끗하":1,"하게":1,"실":2,"실것":2,"이요":3,"요만":3,"가죄":1,"죄없":1,"면스":1,"스스":1,"스로":1,"로속":1,"속":3,"속이":1,"이고":1,"고또":1,"또":2,"또진":1,"리속":2,"에있":2,"지아":3,"니할":1,"할":1,"할것":1,"리죄":2,"를자":1,"자백":1,"백":1,"백하":1,"면저":1,"는미":1,"미":1,"미쁘":1,"쁘":1,"쁘시":1,"시고":1,"고의":1,"의로":1,"우사":1,"사우":1,"를사":1,"사하":1,"하시":1,"시며":1,"며":1,"며모":1,"든불":1,"불":1,"불의":1,"의에":1,"서우":1,"를깨":1,"끗케":1,"가범":1,"범":1,"범죄":1,"죄하":1,"하지":1,"니하":2,"하였":1,"였":1,"였다":1,"면하":1,"님을":1,"을거":1,"말하":1,"는자":1,"만드":1,"드":1,"드는":1,"는것":1,"니또":1,"한그":1,"씀이":1,"하니":1},"verseMap":[{"verse":1,"text":"That which was from the beginning, that which we have heard, that which we have seen with our eyes, that which we saw, and our hands touched, concerning the Word of life"},{"verse":2,"text":"(and the life was revealed, and we have seen, and testify, and declare to you the life, the eternal life, which was with the Father, and was revealed to us);"},{"verse":3,"text":"that which we have seen and heard we declare to you, that you also may have fellowship with us. Yes, and our fellowship is with the Father and with his Son, Jesus Christ."},{"verse":4,"text":"And we write these things to you, that our joy may be fulfilled."},{"verse":5,"text":"This is the message which we have heard from him and announce to you, that God is light, and in him is no darkness at all."},{"verse":6,"text":"If we say that we have fellowship with him and walk in the darkness, we lie and don’t tell the truth."},{"verse":7,"text":"But if we walk in the light as he is in the light, we have fellowship with one another, and the blood of Jesus Christ his Son cleanses us from all sin."},{"verse":8,"text":"If we say that we have no sin, we deceive ourselves, and the truth is not in us."},{"verse":9,"text":"If we confess our sins, he is faithful and righteous to forgive us the sins and to cleanse us from all unrighteousness."},{"verse":10,"text":"If we say that we haven’t sinned, we make him a liar, and his word is not in us."}],"hasArtwork":false,"availableLangs":[]}]