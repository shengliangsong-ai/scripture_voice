1,"冕":1,"冕是":1,"是什":1,"什":1,"什么":1,"么":1,"么呢":1,"呢":1,"呢岂":1,"岂":1,"岂不":1,"们主":1,"稣来":1,"来的":1,"的时":1,"时候":1,"候":1,"候你":1,"们在":1,"他面":1,"面前":1,"前站":1,"站":1,"站立":1,"立得":1,"得住":1,"住吗":1,"吗":1,"吗因":1,"就是":1,"的荣":1,"耀我":1},"verseMap":[{"verse":1,"text":"For you yourselves know, brothers, our visit to you wasn’t in vain,"},{"verse":2,"text":"but having suffered before and been shamefully treated, as you know, at Philippi, we grew bold in our God to tell you the Good News of God in much conflict."},{"verse":3,"text":"For our exhortation is not of error, nor of uncleanness, nor in deception."},{"verse":4,"text":"But even as we have been approved by God to be entrusted with the Good News, so we speak—not as pleasing men, but God, who tests our hearts."},{"verse":5,"text":"For neither were we at any time found using words of flattery, as you know, nor a cloak of covetousness (God is witness),"},{"verse":6,"text":"nor seeking glory from men (neither from you nor from others), when we might have claimed authority as apostles of Christ."},{"verse":7,"text":"But we were gentle among you, like a nursing mother cherishes her own children."},{"verse":8,"text":"Even so, affectionately longing for you, we were well pleased to impart to you not the Good News of God only, but also our own souls, because you had become very dear to us."},{"verse":9,"text":"For you remember, brothers, our labor and travail; for working night and day, that we might not burden any of you, we preached to you the Good News of God."},{"verse":10,"text":"You are witnesses with God how holy, righteously, and blamelessly we behaved ourselves toward you who believe."},{"verse":11,"text":"As you know, we exhorted, comforted, and implored every one of you, as a father does his own children,"},{"verse":12,"text":"to the end that you should walk worthily of God, who calls you into his own Kingdom and glory."},{"verse":13,"text":"For this cause we also thank God without ceasing that when you received from us the word of the message of God, you accepted it not as the word of men, but as it is in truth, God’s word, which also works in you who believe."},{"verse":14,"text":"For you, brothers, became imitators of the assemblies of God which are in Judea in Christ Jesus; for you also suffered the same things from your own countrymen, even as they did from the Jews"},{"verse":15,"text":"who killed both the Lord Jesus and their own prophets, and drove us out, and don’t please God, and are contrary to all men,"},{"verse":16,"text":"forbidding us to speak to the Gentiles that they may be saved, to fill up their sins always. But wrath has come on them to the uttermost."},{"verse":17,"text":"But we, brothers, being bereaved of you for a short season in presence, not in heart, tried even harder to see your face with great desire,"},{"verse":18,"text":"because we wanted to come to you—indeed, I, Paul, once and again—but Satan hindered us."},{"verse":19,"text":"For what is our hope, or joy, or crown of rejoicing? Isn’t it even you, before our Lord Jesus at his coming?"},{"verse":20,"text":"For you are our glory and our joy."}],"hasArtwork":true,"artworkUrl":"/data/images/books/1thessalonians.svg","availableLangs":["zh-CN"]},{"id":"1thessalonians_3","bookSlug":"1thessalonians","chapter":3,"reference":"1 Thessalonians 3","title":"1 Thessalonians 3 — Public Domain Study","topics":["1 thessalonians","1thessalonians","nt","scripture","帖撒羅尼迦前書","帖撒罗尼迦前书"],"snippet":{"zh-CN":"我们既不能再忍，就愿意独自等在雅典，"},"tokens":{"13":2,"52":1,"thessalonians":7,"public":2,"domain":2,"study":1,"1thessalonians":2,"nt":1,"scripture":1,"帖撒羅尼迦前書":1,"帖撒罗尼迦前书":2,"我们既不能再忍":1,"就愿意独自等在雅典":1,"打发我们的兄弟在基督福音上作":1,"神执事的":1,"提摩太前去":1,"坚固你们":1,"并在你们所信的道上劝慰你们":1,"免得有人被诸般患难摇动":1,"因为你们自己知道":1,"我们受患难原是命定的":1,"我们在你们那里的时候":1,"预先告诉你们":1,"我们必受患难":1,"以后果然应验了":1,"你们也知道":1,"为此":2,"我既不能再忍":1,"就打发人去":1,"要晓得你们的信心如何":1,"恐怕那诱惑人的到底诱惑了你们":1,"叫我们的劳苦归于徒然":1,"但提摩太刚才从你们那里回来":1,"将你们信心和爱心的好消息报给我们":1,"又说你们常常记念我们":1,"切切地想见我们":1,"如同我们想见你们一样":1,"所以":2,"弟兄们":1,"我们在一切困