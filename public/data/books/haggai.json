你":1,"前就":1,"就是":1,"是从":1,"从这":1,"这九":1,"日起":2,"起":2,"起追":1,"想到":1,"到立":1,"立耶":1,"华殿":1,"殿根":1,"根":1,"根基":1,"基":1,"基的":1,"的日":1,"子仓":1,"仓":1,"仓里":1,"里":1,"里有":1,"有谷":1,"谷种":1,"种":1,"种吗":1,"吗葡":1,"葡":1,"葡萄":1,"萄":1,"萄树":1,"树":4,"树无":1,"无花":1,"花":1,"花果":1,"果":2,"果树":1,"树石":1,"石榴":1,"榴":1,"榴树":1,"树橄":1,"橄":1,"橄榄":1,"榄":1,"榄树":1,"树都":1,"都没":1,"有结":1,"结":1,"结果":1,"果子":1,"子从":1,"从今":1,"今":1,"今日":1,"起我":1,"赐福":1,"福":1,"福与":1,"们这":1,"这月":1,"话二":1,"二次":1,"次临":1,"到哈":1,"要告":1,"告":1,"告诉":1,"诉":1,"诉犹":1,"长所":1,"伯说":1,"说我":2,"必倾":1,"倾":2,"倾覆":2,"覆":2,"覆列":1,"列":2,"列国":1,"的宝":1,"宝座":1,"座":1,"座除":1,"除":1,"除灭":1,"灭":1,"灭列":1,"列邦":1,"邦":1,"邦的":1,"的势":1,"势":1,"势力":1,"力":1,"力并":1,"并倾":1,"覆战":1,"战":1,"战车":1,"车":1,"车和":1,"和坐":1,"坐":1,"坐在":1,"在其":1,"其":1,"其上":1,"的马":1,"马":2,"马必":1,"必跌":1,"跌":1,"跌倒":1,"倒":1,"倒骑":1,"骑":1,"骑马":1,"马的":1,"的败":1,"败":1,"败落":1,"落":1,"落各":1,"各人":1,"人被":1,"被":1,"被弟":1,"弟":1,"弟兄":1,"兄":1,"兄的":1,"的刀":1,"刀":1,"刀所":1,"所杀":1,"杀":1,"杀万":1,"我仆":1,"仆":1,"仆人":1,"人撒":1,"啊到":1,"到那":1,"那日":1,"日我":1,"必以":1,"以你":1,"你为":1,"为印":1,"印":1,"印因":1,"因我":1,"我拣":1,"拣":1,"拣选":1,"选":1,"选了":1,"了你":1,"你这":1},"verseMap":[{"verse":1,"text":"In the seventh month, in the twenty-first day of the month, the LORD’s word came by Haggai the prophet, saying,"},{"verse":2,"text":"“Speak now to Zerubbabel the son of Shealtiel, governor of Judah, and to Joshua the son of Jehozadak, the high priest, and to the remnant of the people, saying,"},{"verse":3,"text":"‘Who is left among you who saw this house in its former glory? How do you see it now? Isn’t it in your eyes as nothing?"},{"verse":4,"text":"Yet now be strong, Zerubbabel,’ says the LORD. ‘Be strong, Joshua son of Jehozadak, the high priest. Be strong, all you people of the land,’ says the LORD, ‘and work, for I am with you,’ says the LORD of Armies."},{"verse":5,"text":"This is the word that I covenanted with you when you came out of Egypt, and my Spirit lived among you. ‘Don’t be afraid.’"},{"verse":6,"text":"For this is what the LORD of Armies says: ‘Yet once more, it is a little while, and I will shake the heavens, the earth, the sea, and the dry land;"},{"verse":7,"text":"and I will shake all nations. The treasure of all nations will come, and I will fill this house with glory, says the LORD of Armies."},{"verse":8,"text":"The silver is mine, and the gold is mine,’ says the LORD of Armies."},{"verse":9,"text":"‘The latter glory of this house will be greater than the former,’ says the LORD of Armies; ‘and in this place I will give peace,’ says the LORD of Armies.”"},{"verse":10,"text":"In the twenty-fourth day of the ninth month, in the second year of Darius, the LORD’s word came by Haggai the prophet, saying,"},{"verse":11,"text":"“The LORD of Armies says: Ask now the priests concerning the law, saying,"},{"verse":12,"text":"‘If someone carries holy meat in the fold of his garment, and with his fold touches bread, stew, wine, oil, or any food, will it become holy?’” The priests answered, “No.”"},{"verse":13,"text":"Then Haggai said, “If one who is unclean by reason of a dead body touches any of these, will it be unclean?” The priests answered, “It will be unclean.”"},{"verse":14,"text":"Then Haggai answered, “‘So is this people, and so is this nation before me,’ says the LORD; ‘and so is every work of their hands. That which they offer there is unclean."},{"verse":15,"text":"Now, please consider from this day and backward, before a stone was laid on a stone in the LORD’s temple."},{"verse":16,"text":"Through all that time, when one came to a heap of twenty measures, there were only ten. When one came to the wine vat to draw out fifty, there were only twenty."},{"verse":17,"text":"I struck you with blight, mildew, and hail in all the work of your hands; yet you didn’t turn to me,’ says the LORD."},{"verse":18,"text":"‘Consider, please, from this day and backward, from the twenty-fourth day of the ninth month, since the day that the foundation of the LORD’s temple was laid, consider it."},{"verse":19,"text":"Is the seed yet in the barn? Yes, the vine, the fig tree, the pomegranate, and the olive tree haven’t produced. From today I will bless you.’”"},{"verse":20,"text":"The LORD’s word came the second time to Haggai in the twenty-fourth day of the month, saying,"},{"verse":21,"text":"“Speak to Zerubbabel, governor of Judah, saying, ‘I will shake the heavens and the earth."},{"verse":22,"text":"I will overthrow the throne of kingdoms. I will destroy the strength of the kingdoms of the nations. I will overthrow the chariots and those who ride in them. The horses and their riders will come down, everyone by the sword of his brother."},{"verse":23,"text":"In that day, says the LORD of Armies, I will take you, Zerubbabel my servant, the son of Shealtiel,’ says the LORD, ‘and will make you like a signet ring, for I have chosen you,’ says the LORD of Armies.”"}],"hasArtwork":true,"artworkUrl":"/data/images/books/haggai.svg","availableLangs":["en","zh-CN"]}]